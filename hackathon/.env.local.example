# Neon AI Gateway — copy to .env.local and fill in real values.
# Create a credential:  neon credentials create --scope ai_gateway:invoke
NEON_AI_GATEWAY_TOKEN=nt_live_...
# Your branch host (from the Neon Console), e.g.:
# https://br-<name>-api.ai.<cell>.<region>.aws.neon.tech
NEON_AI_GATEWAY_BASE_URL=https://br-xxxx-api.ai.c-2.us-east-2.aws.neon.tech
# Optional: override the model (defaults to gpt-5-mini)
# NEON_AI_GATEWAY_MODEL=claude-haiku-4-5

# Vercel AI Gateway — only used for the jev decision model (everything else
# goes through Neon above). Create a key at vercel.com/ai-gateway.
VERCEL_AI_GATEWAY=vck_...
# Optional: override the jev model slug (defaults to typesafe-ai/jev)
# JEV_MODEL=typesafe-ai/jev

# Exa — optional live company and people research. Research is context for
# tailoring only; it is never treated as resume evidence.
EXA_API_KEY=exa_...
# Optional spend ceiling for people research, in USD (default 2).
EXA_AGENT_MAX_COST=2

# AgentMail — optional outreach draft generation. Drafts are saved to the
# configured inbox; this app does not send them.
AGENTMAIL_API_KEY=am_...
AGENTMAIL_INBOX_ID=your-inbox@agentmail.to
# Keep live recipients disabled while testing; drafts use this test address.
OUTREACH_TEST_RECIPIENT=
OUTREACH_LIVE_RECIPIENTS=false
OUTREACH_SENDER_NAME=
