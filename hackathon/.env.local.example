# Copy to .env.local and fill in credentials for this workspace only.
# .env.local is ignored by Git; never commit actual credentials.

# Hosted LLM for resume generation, assessment, summaries, and research briefs.
NEON_AI_GATEWAY_BASE_URL=https://<your-neon-branch>-api.ai.<cell>.<region>.aws.neon.tech
NEON_AI_GATEWAY_TOKEN=<your-neon-ai-gateway-token>
# Optional model override (defaults to gpt-5-mini).
# NEON_MODEL=gpt-5-mini
# Keep local-model discovery off while validating hosted output.
LLM_LOCAL=0

# Optional Vercel AI Gateway fallback for LLM tasks.
AI_GATEWAY_API_KEY=<your-vercel-ai-gateway-key>
# Optional: https://ai-gateway.vercel.sh/v1
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# Optional: anthropic/claude-sonnet-5
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-5

# Optional Vercel key for live Jev decision-model routing.
VERCEL_AI_GATEWAY=<your-vercel-jev-key>
# Optional: override the Jev model slug.
# JEV_MODEL=typesafe-ai/jev

# Exa enables live company and people research. Research is context, not resume evidence.
EXA_API_KEY=<your-exa-api-key>
# Optional cost ceiling in USD (default 2).
EXA_AGENT_MAX_COST=2

# AgentMail saves outreach drafts to this inbox; the app does not send them.
# Create a key scoped to the hackathon inbox with send/read mail access.
AGENTMAIL_API_KEY=<your-agentmail-api-key>
AGENTMAIL_INBOX_ID=<your-hackathon-inbox>@agentmail.to
OUTREACH_TEST_RECIPIENT=
OUTREACH_LIVE_RECIPIENTS=false
OUTREACH_SENDER_NAME=

# Optional live JevRouter service; the CLI demo provider works offline by default.
# JEV_HTTP_URL=http://127.0.0.1:8787
# JEV_PROVIDER=demo
# OPENROUTER_API_KEY=<your-openrouter-api-key>
