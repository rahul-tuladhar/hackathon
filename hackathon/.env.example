# The app needs one LLM provider. Providers are tried in order and it falls
# over to the next on failure. A deterministic mock is the last resort.

# --- 1. Neon AI Gateway (preferred) ----------------------------------------
# From the Neon Console: Connect > AI Gateway tab, or `neon env pull`.
# NEON_AI_GATEWAY_BASE_URL is the bare branch host, e.g.
#   https://br-winter-pond-aptw82ef-api.ai.c-2.us-east-2.aws.neon.tech
# NEON_AI_GATEWAY_BASE_URL=https://br-xxxx-api.ai.c-2.us-east-2.aws.neon.tech
# NEON_AI_GATEWAY_TOKEN=nt_live_...
# NEON_MODEL=gpt-5-mini            # any model in the Neon catalog

# --- 2. Vercel AI Gateway --------------------------------------------------
# AI_GATEWAY_API_KEY=...
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-5

# --- 3. Any OpenAI-compatible endpoint -------------------------------------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=...
# LLM_MODEL=gpt-5.5

# --- 4. Local LM Studio (optional, never required) -------------------------
# Auto-detected at http://127.0.0.1:1234/v1 when no hosted gateway is set.
# Auto-detection skips embedding models and any "abliterated" variant.
# LLM_LOCAL=1
# LMSTUDIO_MODEL=qwen3-30b-a3b

# --- 5. OpenCode Zen -------------------------------------------------------
# OPENCODE_API_KEY=...
# OPENCODE_MODEL=gpt-5.5

# --- JEV -------------------------------------------------------------------
# Run `npm run jev` to serve JevRouter on 8787 for the fast HTTP route.
# Otherwise the app shells out to the JevRouter CLI with the offline demo
# provider. Set JEV_PROVIDER=openrouter + OPENROUTER_API_KEY for live Jev.
# JEV_HTTP_URL=http://127.0.0.1:8787
# JEV_PROVIDER=demo

# --- Research (optional) ---------------------------------------------------
# EXA_API_KEY=...

EXA_API_KEY=
EXA_AGENT_MAX_COST=2
RESEARCH_ON_BOOT=true

# AgentMail: outreach drafts and sent emails are always addressed to this inbox,
# never to the researched contacts.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=your-inbox@agentmail.to
# While OUTREACH_LIVE_RECIPIENTS isn't "true", drafts are addressed to this test
# address (or to nobody if empty) instead of the researched contacts.
OUTREACH_TEST_RECIPIENT=
OUTREACH_LIVE_RECIPIENTS=false
# Name the drafted emails are signed with.
OUTREACH_SENDER_NAME=
